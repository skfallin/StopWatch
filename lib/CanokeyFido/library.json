{
  "name": "CanokeyFido",
  "version": "3.0.3-stopwatch-lab",
  "description": "CanoKey FIDO-only port; no eFuse provisioning",
  "license": "Apache-2.0",
  "build": {
    "flags": [
      "-Ivendor/include",
      "-Ivendor/applets/ctap",
      "-Ivendor/littlefs",
      "-Ivendor/tinycbor/src",
      "-Ivendor/canokey-crypto/include",
      "-DCBOR_NO_FLOATING_POINT",
      "-DCBOR_PARSER_MAX_RECURSIONS=8",
      "-DLFS_NO_DEBUG",
      "-DLFS_NO_WARN",
      "-DLFS_NO_ERROR",
      "-Dlfs_dir_close=key_lfs_dir_close",
      "-Dlfs_dir_open=key_lfs_dir_open",
      "-Dlfs_dir_read=key_lfs_dir_read",
      "-Dlfs_dir_rewind=key_lfs_dir_rewind",
      "-Dlfs_dir_seek=key_lfs_dir_seek",
      "-Dlfs_dir_tell=key_lfs_dir_tell",
      "-Dlfs_file_close=key_lfs_file_close",
      "-Dlfs_file_open=key_lfs_file_open",
      "-Dlfs_file_opencfg=key_lfs_file_opencfg",
      "-Dlfs_file_read=key_lfs_file_read",
      "-Dlfs_file_rewind=key_lfs_file_rewind",
      "-Dlfs_file_seek=key_lfs_file_seek",
      "-Dlfs_file_size=key_lfs_file_size",
      "-Dlfs_file_sync=key_lfs_file_sync",
      "-Dlfs_file_tell=key_lfs_file_tell",
      "-Dlfs_file_truncate=key_lfs_file_truncate",
      "-Dlfs_file_write=key_lfs_file_write",
      "-Dlfs_format=key_lfs_format",
      "-Dlfs_fs_gc=key_lfs_fs_gc",
      "-Dlfs_fs_grow=key_lfs_fs_grow",
      "-Dlfs_fs_mkconsistent=key_lfs_fs_mkconsistent",
      "-Dlfs_fs_size=key_lfs_fs_size",
      "-Dlfs_fs_stat=key_lfs_fs_stat",
      "-Dlfs_fs_traverse=key_lfs_fs_traverse",
      "-Dlfs_getattr=key_lfs_getattr",
      "-Dlfs_migrate=key_lfs_migrate",
      "-Dlfs_mkdir=key_lfs_mkdir",
      "-Dlfs_mount=key_lfs_mount",
      "-Dlfs_remove=key_lfs_remove",
      "-Dlfs_removeattr=key_lfs_removeattr",
      "-Dlfs_rename=key_lfs_rename",
      "-Dlfs_setattr=key_lfs_setattr",
      "-Dlfs_stat=key_lfs_stat",
      "-Dlfs_unmount=key_lfs_unmount",
      "-DMBEDTLS_ALLOW_PRIVATE_ACCESS",
      "-Dhmac_sha256=key_hmac_sha256",
      "-Dhmac_sha1=key_hmac_sha1",
      "-Dlfs_crc=key_lfs_crc",
      "-Dsha1_init=key_sha1_init",
      "-Dsha1_update=key_sha1_update",
      "-Dsha1_final=key_sha1_final",
      "-Dsha1_raw=key_sha1_raw",
      "-Dsha256_init=key_sha256_init",
      "-Dsha256_update=key_sha256_update",
      "-Dsha256_final=key_sha256_final",
      "-Dsha256_raw=key_sha256_raw",
      "-Drandom_buffer=key_random_buffer",
      "-Drandom32=key_random32",
      "-Dcbor_encode_byte_string=key_cbor_encode_byte_string",
      "-Dcbor_encode_float_as_half_float=key_cbor_encode_float_as_half_float",
      "-Dcbor_encode_floating_point=key_cbor_encode_floating_point",
      "-Dcbor_encode_int=key_cbor_encode_int",
      "-Dcbor_encode_negative_int=key_cbor_encode_negative_int",
      "-Dcbor_encode_simple_value=key_cbor_encode_simple_value",
      "-Dcbor_encode_tag=key_cbor_encode_tag",
      "-Dcbor_encode_text_string=key_cbor_encode_text_string",
      "-Dcbor_encode_uint=key_cbor_encode_uint",
      "-Dcbor_encoder_close_container=key_cbor_encoder_close_container",
      "-Dcbor_encoder_close_container_checked=key_cbor_encoder_close_container_checked",
      "-Dcbor_encoder_create_array=key_cbor_encoder_create_array",
      "-Dcbor_encoder_create_map=key_cbor_encoder_create_map",
      "-Dcbor_encoder_init=key_cbor_encoder_init",
      "-Dcbor_encoder_init_writer=key_cbor_encoder_init_writer",
      "-Dcbor_error_string=key_cbor_error_string",
      "-Dcbor_parser_init=key_cbor_parser_init",
      "-Dcbor_parser_init_reader=key_cbor_parser_init_reader",
      "-Dcbor_value_advance=key_cbor_value_advance",
      "-Dcbor_value_advance_fixed=key_cbor_value_advance_fixed",
      "-Dcbor_value_calculate_string_length=key_cbor_value_calculate_string_length",
      "-Dcbor_value_enter_container=key_cbor_value_enter_container",
      "-Dcbor_value_get_half_float_as_float=key_cbor_value_get_half_float_as_float",
      "-Dcbor_value_get_int64_checked=key_cbor_value_get_int64_checked",
      "-Dcbor_value_get_int_checked=key_cbor_value_get_int_checked",
      "-Dcbor_value_leave_container=key_cbor_value_leave_container",
      "-Dcbor_value_map_find_value=key_cbor_value_map_find_value",
      "-Dcbor_value_reparse=key_cbor_value_reparse",
      "-Dcbor_value_skip_tag=key_cbor_value_skip_tag",
      "-Dcbor_value_text_string_equals=key_cbor_value_text_string_equals",
      "-Dcbor_value_to_pretty_advance=key_cbor_value_to_pretty_advance",
      "-Dcbor_value_to_pretty_advance_flags=key_cbor_value_to_pretty_advance_flags",
      "-Dcbor_value_to_pretty_stream=key_cbor_value_to_pretty_stream",
      "-Dcbor_value_validate=key_cbor_value_validate",
      "-Dcbor_value_validate_basic=key_cbor_value_validate_basic"
    ],
    "srcDir": ".",
    "srcFilter": [
      "+<port/*.c>",
      "+<port/*.cpp>",
      "+<vendor/applets/ctap/*.c>",
      "-<vendor/applets/ctap/u2f.c>",
      "+<vendor/src/common.c>",
      "+<vendor/canokey-crypto/src/*.c>",
      "+<vendor/littlefs/*.c>",
      "+<vendor/src/fs.c>",
      "+<vendor/tinycbor/src/cborencoder.c>",
      "+<vendor/tinycbor/src/cborparser.c>"
    ],
    "includeDir": "port"
  }
}
